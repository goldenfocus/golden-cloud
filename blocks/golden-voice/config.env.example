# golden-voice config — copy to config.env and edit to taste. Sourced by local-tts.sh.
# Defaults are sane; this file is optional. The installer copies it to
# ~/.claude/local-tts/config.env if you don't already have one.

# Backend: say (now) | xtts (later, your cloned voice)
# LOCAL_TTS_BACKEND=say

# macOS voice name. Leave unset to auto-pick the best installed one.
# Upgrade tip: System Settings → Accessibility → Spoken Content → System Voice →
# manage voices → download a "Premium"/"Enhanced" voice (e.g. Ava), then set it here.
# LOCAL_TTS_VOICE="Samantha"          # swap to Karen/Moira/Daniel/Tessa, or a Premium voice

# Speaking rate (words per minute). macOS default ~175; lower = sultrier.
# LOCAL_TTS_RATE=150

# Optional sox effect chain (needs `brew install sox`). Tune to taste.
# Example "warm" preset: pitched down a touch, fuller low end, a little room.
# LOCAL_TTS_EFFECTS="pitch -120 bass +3 reverb 22 gain -1"

# ── XTTS (later, your cloned voice) ───────────────────────────
# Flip the backend once you've recorded a sample (run record-voice.sh).
# LOCAL_TTS_BACKEND=xtts
# Path to your 15-30s cloned-voice sample. Used only when BACKEND=xtts.
# LOCAL_TTS_SPEAKER_WAV="$HOME/.claude/local-tts/my-voice.wav"
